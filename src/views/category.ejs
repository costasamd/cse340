<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= categoryDetail.name %>
        </h2>

        <ul>
            <% projectsCat.forEach(project => { %> 
                
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        </ul>

        <% if (user && user.roles_name === 'admin') { %>
            <p><a href="/edit-category/<%= categoryDetail.category_id %>">Edit Category</a></p>
        <% } %>

    </main>

    <%- include('partials/footer') %>