<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetail.title %>
        </h2>
        
        <p>Description: <%= projectDetail.description %></p>
        <p><strong>Date: <%= projectDetail.formatted_date %></strong></p>
        <p><strong>Location: <%= projectDetail.location %></strong></p>
        <h3><a href="/organization/<%= projectDetail.organization_id %>"><%= projectDetail.name %></a></h3>
        
        <ul>
            <% categoryTag.forEach(tag => { %>
                <li>
                    <p><a href="/category/<%= tag.category_id %>"><%= tag.name %></a></p>
                </li>
            <% }); %>
        </ul>

        <% if (isLoggedIn) { %>

            <% if (isAssigned) { %>
                <p>You are assigned to this project.</p>
            <% } else { %>
                <form action="/projects/assign/<%= projectDetail.project_id %>" method="post">
                    <button type="submit">Volunteer for this project</button>
                </form>
            <% }; %>
        <% } %>

        <% if (user && user.roles_name === 'admin') { %>
            <p><a href="/assign-categories/<%= projectDetail.project_id %>">Edit Categories</a></p>
            <p><a href="/edit-project/<%= projectDetail.project_id %>">Edit Project</a></p>
        <% } %>

        

    </main>

    <%- include('partials/footer') %>