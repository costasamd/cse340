<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Users that are registered:</p>
        <ul>
            <% users.forEach(user=> { %>
                <li>
                    <h3><%= user.name %></h3>
                    <p><%= user.email %></p>
                    <p>Role: <%= user.roles_name %></p>
                </li>
                <% }); %>
        </ul>
    </main>
                <%- include('partials/footer') %>